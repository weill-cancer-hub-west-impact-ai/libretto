    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "svelte-codemirror-editor": "^2.1.0",
    "svelte-exmarkdown": "^5.0.2",
    "svelte-fa": "^4.0.4",
    "uuid": "^13.0.0"
  }
